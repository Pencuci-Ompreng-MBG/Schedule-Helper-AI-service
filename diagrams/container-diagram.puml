@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram - AI Schedule Helper System

Person(user, "User", "Pengguna yang ingin mengatur tugas, deadline, dan merencanakan jadwal harian.")

System_Boundary(schedule_system, "AI Schedule Helper") {

    Container(web_app, "Web Application", "Next.js, React, Tailwind","Menyediakan antarmuka Chat AI, Blueprint Editor (kiri), dan Visualisasi Kalender (kanan). Menangani interaksi HITL.")

    Container(ai_service, "AI Agent Service", "Python, LangGraph","Orkestrator alur kerja AI (Router, Counselor, Prioritizer). Menangani state percakapan dan kalkulasi penjadwalan.")

    Container(backend_api, "Core Backend API", "NestJS, Prisma","Menyediakan endpoint untuk manajemen data jadwal mentah, autentikasi user, dan bertindak sebagai proxy ke Google Calendar.")

    ContainerDb(db, "Database", "PostgreSQL/NeonDB","Menyimpan data blueprint tugas, preferensi pengguna, dan riwayat jadwal.")

    ContainerDb(redis, "Redis Cache", "Redis","Menyimpan cache response AI, state LangGraph, session percakapan, dan hasil scheduling untuk mempercepat respons.")
}

System_Ext(llm_api, "LLM Provider", "Model bahasa (Groq) yang memberikan kemampuan penalaran, ekstraksi teks, dan komunikasi empatik.")

System_Ext(gcal_api, "Google Calendar API","Sistem kalender pihak ketiga (Google) untuk sinkronisasi jadwal akhir dan membaca jadwal existing.")

Rel(user, web_app, "Kirim pesan, edit tugas, & approve jadwal", "HTTPS/UI")

Rel(web_app, ai_service, "Kirim chat & terima response stream (SSE)", "JSON/HTTPS")

Rel(web_app, backend_api, "Tarik data user & konfigurasi awal", "REST API")

Rel(ai_service, llm_api,"Kirim system prompt & context, terima output terstruktur","REST API")

Rel(ai_service, backend_api,"Fetch raw schedules untuk deteksi bentrokan (collision)","REST API")

Rel(ai_service, redis,"Read/Write cache AI, state workflow, dan hasil scheduling","TCP")

Rel(backend_api, db,"Read/Write data jadwal","TCP")

Rel(backend_api, gcal_api,"Sinkronisasi dua arah untuk event kalender","REST/OAuth2")

SHOW_LEGEND()
@enduml